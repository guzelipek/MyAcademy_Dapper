@model CreateProductDto
@{
    ViewData["Title"] = "Yeni Ürün Oluştur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3>Yeni Ürün Oluştur</h3>
<form method="post">
    <div class="form-group">
        <label>Ürün Adı</label>
        <input type="text" asp-for="Name" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Görsel Url</label>
        <input type="text" asp-for="ImageUrl" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Fiyat ₺</label>
        <input type="number" asp-for="Price" class="form-control" step="0.01" required />
    </div>
    <div class="form-group">
        <label>Stok</label>
        <input type="number" asp-for="Stock" class="form-control" required />
    </div>
    <div class="form-group">
        <input type="checkbox" asp-for="IsActive" class="form-check-input"/>
        <label class="form-check-label">Durum</label>
    </div>
    <div class="form-group">
        <label>Kategori</label>
        <select class="form-control" asp-for="CategoryId" asp-items="@ViewBag.Categories" required>
            <option selected disabled value="">Kategori Seçiniz</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Oluştur</button>
</form>